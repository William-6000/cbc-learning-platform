generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum PathwayCode {
  STEM
  SOCIAL_SCIENCES
  ARTS_AND_SPORTS
}

enum SchoolType {
  PUBLIC
  PRIVATE
  INTERNATIONAL
  TVET
}

enum ContentType {
  video
  pdf
  quiz
  activity
}

enum AssessmentType {
  formative
  summative
  project
}

enum QuestionType {
  MCQ
  structured
  essay
}

enum CompetencyKey {
  COMMUNICATION_COLLABORATION
  CRITICAL_THINKING_PROBLEM_SOLVING
  CREATIVITY_IMAGINATION
  CITIZENSHIP
  DIGITAL_LITERACY
  LEARNING_TO_LEARN
  SELF_EFFICACY
}

enum NationalValue {
  UNITY
  INTEGRITY
  SUSTAINABILITY
  RESPONSIBILITY
  RESPECT
  PATRIOTISM
}

model School {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  county        String
  type          SchoolType     @default(PUBLIC)
  users         User[]
  announcements Announcement[]
  createdAt     DateTime       @default(now())
}

model Pathway {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  code           PathwayCode @unique
  name           String
  description    String
  careerOutcomes String[]
  kuccpsCourses  String[]
  tvetOptions    String[]
  subjects       Subject[]
}

model User {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String              @unique
  passwordHash      String
  role              Role
  pathway           PathwayCode?
  grade             Int?
  schoolId          String?             @map("school_id") @db.ObjectId
  school            School?             @relation(fields: [schoolId], references: [id])
  taughtSubjectIds  String[]            @map("taught_subject_ids") @db.ObjectId
  taughtSubjects    Subject[]           @relation("TeacherSubjects", fields: [taughtSubjectIds], references: [id])
  studentProgress   StudentProgress[]   @relation("StudentProgressStudent")
  grades            Grade[]             @relation("StudentGrades")
  teacherNotes      TeacherNote[]       @relation("TeacherNotesTeacher")
  sentAnnouncements Announcement[]      @relation("AnnouncementAuthor")
  sentMessages      Message[]           @relation("MessageSender")
  receivedMessages  Message[]           @relation("MessageReceiver")
  competencies      StudentCompetency[]
  children          ParentStudent[]     @relation("ParentLinks")
  parents           ParentStudent[]     @relation("StudentLinks")
    createdAt         DateTime            @default(now())
}

model ParentStudent {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String @map("parent_id") @db.ObjectId
  studentId String @map("student_id") @db.ObjectId
  parent    User   @relation("ParentLinks", fields: [parentId], references: [id])
  student   User   @relation("StudentLinks", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model Subject {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  pathwayId    String        @map("pathway_id") @db.ObjectId
  pathway      Pathway       @relation(fields: [pathwayId], references: [id])
  gradeLevel   Int           @map("grade_level")
  syllabusCode String        @map("syllabus_code")
  overview     String
  resources    Json          @default("[]")
  teacherIds   String[]      @map("teacher_ids") @db.ObjectId
  teachers     User[]        @relation("TeacherSubjects", fields: [teacherIds], references: [id])
  units        Unit[]
  assessments  Assessment[]
  teacherNotes TeacherNote[]

  @@unique([name, gradeLevel])
}

model Unit {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  subjectId        String          @map("subject_id") @db.ObjectId
  subject          Subject         @relation(fields: [subjectId], references: [id])
  title            String
  sequenceNumber   Int             @map("sequence_number")
  learningOutcomes String[]        @map("learning_outcomes")
  projectBrief     String
  rubric           Json            @default("[]")
  values           NationalValue[]
  ppiLinks         String[]
  lessons          Lesson[]
  teacherNotes     TeacherNote[]

  @@unique([subjectId, sequenceNumber])
}

model Lesson {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  unitId       String            @map("unit_id") @db.ObjectId
  unit         Unit              @relation(fields: [unitId], references: [id])
  title        String
  contentType  ContentType       @map("content_type")
  contentUrl   String            @map("content_url")
  durationMins Int               @map("duration_mins")
  notesPrompt  String
  progress     StudentProgress[]
}

model Assessment {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  subjectId    String         @map("subject_id") @db.ObjectId
  subject      Subject        @relation(fields: [subjectId], references: [id])
  title        String
  type         AssessmentType
  totalMarks   Int            @map("total_marks")
  dueDate      DateTime       @map("due_date")
  durationMins Int            @default(45) @map("duration_mins")
  questions    Question[]
  grades       Grade[]
}

model Question {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId  String       @map("assessment_id") @db.ObjectId
  assessment    Assessment   @relation(fields: [assessmentId], references: [id])
  text          String
  type          QuestionType
  marks         Int
  correctAnswer String?      @map("correct_answer")
  options       String[]
  explanation   String?
}

model StudentProgress {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String    @map("student_id") @db.ObjectId
  lessonId      String    @map("lesson_id") @db.ObjectId
  student       User      @relation("StudentProgressStudent", fields: [studentId], references: [id])
  lesson        Lesson    @relation(fields: [lessonId], references: [id])
  completedAt   DateTime? @map("completed_at")
  score         Float?
  timeSpentMins Int       @default(0) @map("time_spent_mins")
  personalNotes String?

  @@unique([studentId, lessonId])
}

model Grade {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String     @map("student_id") @db.ObjectId
  assessmentId   String     @map("assessment_id") @db.ObjectId
  student        User       @relation("StudentGrades", fields: [studentId], references: [id])
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  marksObtained  Float      @map("marks_obtained")
  teacherRemarks String?    @map("teacher_remarks")
  gradedAt       DateTime?  @map("graded_at")
  submission     Json       @default("{}")
  needsReview    Boolean    @default(false)

  @@unique([studentId, assessmentId])
}

model TeacherNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String   @map("teacher_id") @db.ObjectId
  subjectId String   @map("subject_id") @db.ObjectId
  unitId    String?  @map("unit_id") @db.ObjectId
  teacher   User     @relation("TeacherNotesTeacher", fields: [teacherId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  unit      Unit?    @relation(fields: [unitId], references: [id])
  fileUrl   String   @map("file_url")
  title     String
  createdAt DateTime @default(now())
}

model Announcement {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String       @map("school_id") @db.ObjectId
  authorId  String       @map("author_id") @db.ObjectId
  title     String
  body      String
  pathway   PathwayCode?
  school    School       @relation(fields: [schoolId], references: [id])
  author    User         @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")
}

model Message {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @map("sender_id") @db.ObjectId
  receiverId String   @map("receiver_id") @db.ObjectId
  subject    String
  body       String
  read       Boolean  @default(false)
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
}

model StudentCompetency {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String        @map("student_id") @db.ObjectId
  competency CompetencyKey
  score      Int           @default(50)
  evidence   String?
  student    User          @relation(fields: [studentId], references: [id])

  @@unique([studentId, competency]
}
