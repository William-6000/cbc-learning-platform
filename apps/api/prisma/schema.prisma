generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum Grade {
  GRADE_10
  GRADE_11
  GRADE_12
}

enum PathwayName {
  STEM
  SOCIAL_SCIENCES
  ARTS_AND_SPORTS_SCIENCE
}

enum RubricScore {
  EE // Exceeding Expectation
  ME // Meeting Expectation
  AE // Approaching Expectation
  BE // Below Expectation
}

enum CslStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Competency {
  COMMUNICATION
  CRITICAL_THINKING
  CREATIVITY
  CITIZENSHIP
  DIGITAL_LITERACY
  LEARNING_TO_LEARN
  SELF_EFFICACY
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  grade         Grade?    // only relevant for STUDENT role
  schoolId      String    @db.ObjectId
  school        School    @relation(fields: [schoolId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // STUDENT relations
  studentProfile   StudentProfile?
  cslLogs          CslLog[]
  assessmentScores AssessmentScore[]

  // TEACHER relations
  teacherClasses   ClassEnrollment[] @relation("TeacherClasses")
  gradedScores     AssessmentScore[] @relation("GradedBy")

  // PARENT relations
  parentChildren   ParentChild[]     @relation("ParentRelation")

  // reverse PARENT
  childParents     ParentChild[]     @relation("ChildRelation")

  @@map("users")
}

// ─────────────────────────────────────────────
// SCHOOL (tenant isolation)
// ─────────────────────────────────────────────

model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  county    String
  code      String   @unique
  users     User[]
  classes   Class[]
  createdAt DateTime @default(now())

  @@map("schools")
}

// ─────────────────────────────────────────────
// PARENT-CHILD LINK
// ─────────────────────────────────────────────

model ParentChild {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String @db.ObjectId
  childId   String @db.ObjectId
  parent    User   @relation("ParentRelation", fields: [parentId], references: [id])
  child     User   @relation("ChildRelation",  fields: [childId],  references: [id])

  @@map("parent_children")
}

// ─────────────────────────────────────────────
// STUDENT PROFILE
// ─────────────────────────────────────────────

model StudentProfile {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  userId              String      @unique @db.ObjectId
  user                User        @relation(fields: [userId], references: [id])
  pathwayId           String?     @db.ObjectId
  pathway             Pathway?    @relation(fields: [pathwayId], references: [id])
  electiveSubjectIds  String[]    @db.ObjectId
  compulsoryEnrolled  Boolean     @default(false)
  totalCslHours       Float       @default(0)
  updatedAt           DateTime    @updatedAt

  @@map("student_profiles")
}

// ─────────────────────────────────────────────
// PATHWAY & SUBJECTS
// ─────────────────────────────────────────────

model Pathway {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            PathwayName @unique
  description     String
  subjects        Subject[]   @relation("PathwaySubjects")
  studentProfiles StudentProfile[]

  @@map("pathways")
}

model Subject {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  code          String    @unique
  isCompulsory  Boolean   @default(false)
  pathwayId     String?   @db.ObjectId
  pathway       Pathway?  @relation("PathwaySubjects", fields: [pathwayId], references: [id])
  assessments   Assessment[]
  createdAt     DateTime  @default(now())

  @@map("subjects")
}

// ─────────────────────────────────────────────
// CLASS & ENROLLMENT
// ─────────────────────────────────────────────

model Class {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  grade       Grade
  schoolId    String            @db.ObjectId
  school      School            @relation(fields: [schoolId], references: [id])
  enrollments ClassEnrollment[]
  assessments Assessment[]
  createdAt   DateTime          @default(now())

  @@map("classes")
}

model ClassEnrollment {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  classId   String  @db.ObjectId
  class     Class   @relation(fields: [classId], references: [id])
  userId    String  @db.ObjectId
  user      User    @relation("TeacherClasses", fields: [userId], references: [id])
  isTeacher Boolean @default(false)

  @@map("class_enrollments")
}

// ─────────────────────────────────────────────
// ASSESSMENT & SCORES
// ─────────────────────────────────────────────

model Assessment {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String
  subjectId        String            @db.ObjectId
  subject          Subject           @relation(fields: [subjectId], references: [id])
  classId          String            @db.ObjectId
  class            Class             @relation(fields: [classId], references: [id])
  competencyTags   Competency[]
  dueDate          DateTime?
  createdAt        DateTime          @default(now())
  scores           AssessmentScore[]

  @@map("assessments")
}

model AssessmentScore {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId String      @db.ObjectId
  assessment   Assessment  @relation(fields: [assessmentId], references: [id])
  studentId    String      @db.ObjectId
  student      User        @relation(fields: [studentId], references: [id])
  teacherId    String?     @db.ObjectId
  teacher      User?       @relation("GradedBy", fields: [teacherId], references: [id])
  score        RubricScore
  feedback     String?
  gradedAt     DateTime?
  createdAt    DateTime    @default(now())

  @@unique([assessmentId, studentId])
  @@map("assessment_scores")
}

// ─────────────────────────────────────────────
// CSL LOG
// ─────────────────────────────────────────────

model CslLog {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String     @db.ObjectId
  student         User       @relation(fields: [studentId], references: [id])
  title           String
  description     String
  hoursLogged     Float
  evidenceUrls    String[]
  status          CslStatus  @default(PENDING)
  teacherFeedback String?
  reviewedById    String?    @db.ObjectId
  submittedAt     DateTime   @default(now())
  reviewedAt      DateTime?

  @@map("csl_logs")
}
